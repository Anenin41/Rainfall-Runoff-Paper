# .gitignore file for Git #
# Author: Konstantinos Garas
# E-mail: kgaras041@gmail.com
# Created: Mon 10 Mar 2025 @ 14:21:25 +0100
# Modified: Mon 16 Nov 2026 @ 19:30:52 +0100

# ===========================================================================
# Generated output
# ===========================================================================

# Every run, report and processing figure is written under results/ by default
# (moment-sw, moment-sw-report, scripts/run_*.sh and processing/*.py all
# resolve to <repo>/results/). Anchored to the repo root on purpose.
/results/

# Rendered documentation: `mkdocs build` output. The sources live in docs/.
/site/

# Run output written anywhere else (for example `moment-sw -o somewhere/`).
# The solver writes CSVs, a JSON sidecar and PDF reports; processing/*.py
# writes PNG, SVG and PDF figures; the run scripts keep a run.log per case.
*.csv
*_run.json
*.pdf
*.png
*.PNG
*.svg
*.jpg
*.jpeg
*.gif
*.log

# ...except where these file types are source, not output:
# - test fixtures: reference values captured from the pre-refactor solver.
#   The regression suite fails to even import without them.
!tests/data/**
# - images and figures used by the documentation site.
!docs/**/*.png
!docs/**/*.svg
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.gif

# ===========================================================================
# Python and uv
# ===========================================================================

__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment created by `uv sync`. uv.lock IS source: keep it tracked.
.venv/

# Packaging
/build/
/dist/
*.egg-info/

# Test and coverage output (pytest, pytest-cov)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Linters and type checkers
.ruff_cache/
.mypy_cache/
.dmypy.json

# Notebooks
.ipynb_checkpoints/

# Local environment variables
.env
.envrc
.direnv/

# ===========================================================================
# Editors, agents and the operating system
# ===========================================================================

# Workspace and editor settings
*.code-workspace
.vscode/
.idea/

# Vim / Emacs / KDE backup and swap files
*~
*.swp
*.swo
.*.sw?
\#*\#
.\#*

# Claude Code: local settings and per-user agent notes
.claude/
CLAUDE.md
HANDOFF.md

# Linux trash folders and NFS placeholders
.Trash-*
.nfs*

# macOS / Windows, in case the repo is cloned elsewhere
.DS_Store
Thumbs.db
