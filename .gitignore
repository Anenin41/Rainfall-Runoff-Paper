### Linux ###
*~

# KDE directory preferences
.ipynb_checkpoints

# Python specific files
__pycache__/

# Python virtual environment
.venv/

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

# ignore all executable, database or log files
*.pdf
*.png
*.PNG
*.gif
*.csv
*.jpg
*.jpeg
logfile.txt
structure.txt
data.zip

# ignore results/ folders
Constant_Test_1/
Constant_Test_2/
Constant_Test_3/
Constant_Test_4/
Constant_Test_5/
Horton_Test/
Dry_Wet_Test/
Ersoy/
Non_Wrapping_Pulse/
Smooth_Pulse/
Smooth_Pulse_Inflow_Outflow/

# ignore language auxiliary files
## Python
*.pyc

# ignore all the LaTeX automatically generated files
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.sty
*.ttf
*.nav
*.snm
*.vrb

# ignore the code-workspace file
*.code-workspace
*.vscode

# ignore other specific files
*.docx
